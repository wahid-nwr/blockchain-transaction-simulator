# Application

NODE_ENV=production

# Database

POSTGRES_USER=tether
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mini_tether

DATABASE_URL=postgresql://tether:change-me@postgres:5432/mini_tether


# Blockchain

RPC_URL=http://host.docker.internal:8545

# EVM chain the platform talks to (default 31337 = local Anvil). It must match
# the chain served by RPC_URL: viem signs every transaction for this chain id,
# and /health/ready reports `chain_mismatch` if the RPC serves a different one.
# Robinhood Chain testnet:
#   EVM_CHAIN_ID=46630
#   RPC_URL=https://rpc.testnet.chain.robinhood.com
EVM_CHAIN_ID=31337

# --- EVM log indexer (workers/event.listener.ts) -----------------------------
# Defaults suit a local node. For a public chain, set the first two.
#
# First block to index for a token that has never been indexed. Set it to the
# block the contract was deployed in; the default (0) crawls the whole chain.
# EVM_INDEX_START_BLOCK=0
#
# Index only blocks this many behind the head, so a shallow reorg cannot leave
# transfers from an orphaned block in the database (there is no rollback).
# EVM_INDEX_CONFIRMATIONS=0
#
# Largest eth_getLogs block span per request. Providers cap this; the indexer
# halves it automatically if rejected, but a correct value avoids the retries.
# EVM_LOGS_MAX_BLOCK_RANGE=2000
#
# Windows per token per cycle; a long catch-up continues on the next cycle.
# EVM_INDEX_MAX_WINDOWS_PER_RUN=25
#
# Delay between indexing cycles. After failed cycles it backs off (doubling, up
# to 60s), which matters on a rate-limited public RPC.
# EVENT_LISTENER_INTERVAL_MS=5000


# Authentication

JWT_SECRET=change-me


# Registering an EXTERNAL wallet requires a signed challenge proving the user
# controls the address (stops address squatting). Keep on for public deployments.
REQUIRE_WALLET_OWNERSHIP_PROOF=true

# Wallet custody (server-signed CUSTODIAL wallets)
# Use "aws" in production: keys are encrypted by AWS KMS and the container
# needs AWS_REGION plus credentials (an instance/task role, or the standard
# AWS_* variables). "local" is dev/test only: it encrypts wallet keys under
# LOCAL_KMS_MASTER_KEY, which then sits next to the ciphertext it protects.

KMS_PROVIDER=aws
AWS_REGION=us-east-1
# KMS key (ARN or alias) that encrypts NEW custodial wallet keys. Required when
# KMS_PROVIDER=aws; POST /wallets/custodial fails without it. Existing key
# rows keep the id they were encrypted with.
KMS_KEY_ID=
# LOCAL_KMS_MASTER_KEY=            # only when KMS_PROVIDER=local

# Operator key that signs admin mint transactions. Optional if you don't mint.
# It must be the key that DEPLOYED the token contract (the deployer is the
# contract owner, the only account allowed to mint), and on a public network it
# must be a fresh key, never an Anvil/Hardhat default: those private keys are
# public. Keep it in your secret store, not in this file. See "Deploying
# MiniUSDT to a public network" in docs/deployment.md.
# PRIVATE_KEY=


# Worker

CONFIRMATION_INTERVAL_MS=5000

# Scheduled balance drift job (all optional; defaults shown).
# BALANCE_DRIFT_ENABLED=true
# BALANCE_DRIFT_INTERVAL_MS=300000
# BALANCE_DRIFT_PAGE_SIZE=200
# BALANCE_DRIFT_CONCURRENCY=5


# Images

IMAGE_TAG=latest