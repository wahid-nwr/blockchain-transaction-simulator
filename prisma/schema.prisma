generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String        @id @default(uuid())
  name         String        @unique
  apiKeys      ApiKey[]
  users        User[]
  wallets      Wallet[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

model Wallet {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            User              @relation(fields: [ownerId], references: [id])
  chainId          Int
  address          String            @unique
  custodyType      CustodyType       @default(EXTERNAL)
  status           WalletStatus      @default(ACTIVE)
  transactionsFrom Transaction[]     @relation("fromWallet")
  transactionsTo   Transaction[]     @relation("toWallet")
  balances         BalanceSnapshot[]
  custodyKey       WalletCustodyKey?
  createdAt        DateTime          @default(now())

  @@index([tenantId])
}

model WalletCustodyKey {
  id           String    @id @default(uuid())
  walletId     String    @unique
  wallet       Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  encryptedKey Bytes
  kmsKeyId     String
  keyVersion   Int       @default(1)
  createdAt    DateTime  @default(now())
  rotatedAt    DateTime?

  @@index([walletId])
}

model Token {
  id                 String            @id @default(uuid())
  name               String
  symbol             String
  contractAddress    String            @unique
  isActive           Boolean           @default(true)
  decimals           Int               @default(6)
  transactions       Transaction[]
  balances           BalanceSnapshot[]
  lastProcessedBlock BigInt            @default(0)
  transfers          TokenTransfer[]
  eventCursor        TokenEventCursor?
  createdAt          DateTime          @default(now())
}

model TokenEventCursor {
  id                    String    @id @default(uuid())
  tokenId               String
  lastProcessedBlock    BigInt    @default(0)
  lastProcessedLogIndex BigInt    @default(0)
  lastSuccessfulSync    DateTime?
  lastFailedSync        DateTime?
  failureCount          Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  token                 Token     @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([tokenId])
}

model Transaction {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id])
  tokenId               String
  token                 Token             @relation(fields: [tokenId], references: [id])
  fromWalletId          String
  fromWallet            Wallet            @relation("fromWallet", fields: [fromWalletId], references: [id])
  toWalletId            String
  toWallet              Wallet            @relation("toWallet", fields: [toWalletId], references: [id])
  txHash                String?           @unique
  amount                BigInt
  nonce                 BigInt?
  gasUsed               BigInt?
  blockNumber           BigInt?
  status                TransactionStatus @default(PENDING)
  createdAt             DateTime          @default(now())
  submittedAt           DateTime?
  confirmationStartedAt DateTime?
  confirmedAt           DateTime?
  failureReason         String?
  failedAt              DateTime?
  idempotencyKey        IdempotencyKey?

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([status, submittedAt])
}

model BalanceSnapshot {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  tokenId     String
  token       Token    @relation(fields: [tokenId], references: [id])
  balance     BigInt
  blockNumber BigInt
  updatedAt   DateTime @updatedAt

  @@unique([walletId, tokenId])
}

model TokenTransfer {
  id      String @id @default(uuid())
  tokenId String
  token   Token  @relation(fields: [tokenId], references: [id])

  from   String
  to     String
  amount BigInt

  transactionHash String
  logIndex        Int

  blockNumber BigInt
  createdAt   DateTime @default(now())

  @@unique([transactionHash, logIndex])
  @@index([from])
  @@index([to])
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(USER)
  refreshTokens RefreshToken[]
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  wallets       Wallet[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  keyHash    String    @unique
  keyPrefix  String
  name       String
  active     Boolean   @default(true)
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([tenantId, keyPrefix])
  @@index([tenantId, active])
  @@index([keyPrefix])
}

model SchedulerLease {
  name      String   @id
  ownerId   String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model IndexerState {
  id                 String   @id
  chainId            Int
  lastProcessedBlock BigInt
  updatedAt          DateTime @updatedAt
}

model AuditLog {
  id String @id @default(uuid())

  tenantId String?
  userId   String?

  action     String
  resource   String
  resourceId String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

model IdempotencyKey {
  id            String   @id @default(uuid())
  tenantId      String
  key           String
  requestHash   String
  transactionId String?  @unique
  response      Json?
  status        String
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId, expiresAt])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  aggregateId String
  type        String
  payload     Json
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([published, createdAt])
}

enum WalletStatus {
  ACTIVE
  SUSPENDED
}

enum TransactionStatus {
  PENDING
  SUBMITTED
  CONFIRMING
  CONFIRMED
  FAILED
  EXPIRED
}

enum Role {
  ADMIN
  USER
  SERVICE
}

enum CustodyType {
  CUSTODIAL
  EXTERNAL
  LOCAL
  KMS
}
