  "item": [
    {
      "name": "01 - Tenant Setup",
      "item": [
        {
          "name": "Create Tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Postman Reconciliation Tenant\"}"
            },
            "url": "{{baseUrl}}/api/v1/tenants"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"tenantId\", json.data.id || json.data.tenant.id);",
                  "    pm.collectionVariables.set(\"tenantApiKey\", json.data.apiKey);",
                  "    pm.collectionVariables.set(\"userEmail\", `postman-${Date.now()}@example.com`);",
                  "    pm.collectionVariables.set(\"tokenId\", \"\");",
                  "    pm.collectionVariables.set(\"walletId\", \"\");",
                  "    pm.collectionVariables.set(\"receiverWalletId\", \"\");",
                  "}",
                  "else {",
                  "    console.log(\"Tenant creation failed:\", json);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-key",
                "value": "{{tenantApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{userEmail}}\", \"password\": \"{{userPassword}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set(\"userId\", json.data.id);",
                  "}",
                  "else {",
                  "    console.log(\"User registration failed:\", pm.response.text());",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "MANUAL STEP - Promote user to ADMIN (run SQL, then continue)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/health",
            "description": "Role changes are not exposed through the API, so promote the user directly in the database BEFORE running Login (the role is likely baked into the JWT at login time).\n\nSQL:\nUPDATE \"User\" SET role = 'ADMIN' WHERE email = '<value of userEmail>';\n\nThe exact statement with your current userEmail is printed in the Postman Console when this request runs. This request itself is only a health check and a reminder."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = pm.collectionVariables.get('userEmail');",
                  "console.log('>>> Promote this user to ADMIN in the database before running Login:');",
                  "console.log(`docker exec -it blockchain-postgres psql -U tether -d mini_tether -c \"UPDATE \\\\\"User\\\\\" SET role = 'ADMIN' WHERE email = '${email}';\"`);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{userEmail}}\", \"password\": \"{{userPassword}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set(\"accessToken\", json.data.accessToken);",
                  "",
                  "    // Best-effort check that the user was promoted before logging in.",
                  "    try {",
                  "        const payload = JSON.parse(atob(json.data.accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "        if (payload.role && payload.role !== 'ADMIN') {",
                  "            console.warn(`Logged in with role ${payload.role}. Promote the user to ADMIN, then log in again.`);",
                  "        }",
                  "    } catch (e) {",
                  "        // Token format or claim name differs; skip the check.",
                  "    }",
                  "}",
                  "else {",
                  "    console.log(\"Login failed:\", pm.response.text());",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Wallet & Token Setup",
      "item": [
        {
          "name": "Deploy MiniUSDT (Anvil RPC)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"eth_sendTransaction\", \"params\": [{\"from\": \"{{deployerAddress}}\", \"data\": \"{{miniUsdtBytecode}}\", \"gas\": \"0x2dc6c0\"}]}"
            },
            "url": "{{rpcUrl}}",
            "description": "Deploys a fresh MiniUSDT on Anvil from account #0 (the account behind PRIVATE_KEY, which becomes the contract owner and therefore the only account allowed to mint) and saves the new address into tokenContractAddress. Anvil keeps its dev accounts unlocked, so no signing is needed. Same idea as deployMiniUSDT() in the repo's tests: the address is produced at run time, never hard-coded."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.error || !body.result) {",
                  "    console.error('Deploy failed:', JSON.stringify(body));",
                  "    return;",
                  "}",
                  "",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('rpcUrl'),",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ jsonrpc: '2.0', id: 2, method: 'eth_getTransactionReceipt', params: [body.result] }) }",
                  "}, (err, res) => {",
                  "    const receipt = !err && res.json().result;",
                  "    if (!receipt || receipt.status !== '0x1' || !receipt.contractAddress) {",
                  "        console.error('Deploy receipt problem:', err || JSON.stringify(res.json()));",
                  "        return;",
                  "    }",
                  "    pm.collectionVariables.set('tokenContractAddress', receipt.contractAddress);",
                  "    console.log('MiniUSDT deployed at:', receipt.contractAddress, 'block', parseInt(receipt.blockNumber, 16));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Sender Wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-tenant-key",
                "value": "{{tenantApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"ownerId\": \"{{userId}}\", \"chainId\": {{chainId}}, \"address\": \"{{walletAddress}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/wallets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set(\"walletId\", json.data.id);",
                  "}",
                  "else {",
                  "    console.log(\"Wallet creation failed:\", pm.response.text());",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Receiver Wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-tenant-key",
                "value": "{{tenantApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"ownerId\": \"{{userId}}\", \"chainId\": {{chainId}}, \"address\": \"{{receiverAddress}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/wallets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"receiverWalletId\", pm.response.json().data.id);",
                  "}",
                  "else {",
                  "    console.log(\"Receiver wallet creation failed:\", pm.response.text());",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-tenant-key",
                "value": "{{tenantApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"tokenId\": \"{{tokenRegistrationId}}\", \"name\": \"{{tokenName}}\", \"symbol\": \"{{tokenSymbol}}\", \"blockchain\": \"{{tokenBlockchain}}\", \"contractAddress\": \"{{tokenContractAddress}}\", \"decimals\": {{tokenDecimals}}}"
            },
            "url": "{{baseUrl}}/api/v1/tokens",
            "description": "ADMIN only. registerTokenSchema REQUIRES a uuid field called tokenId, but the server ignores it and assigns its own id, so a throw-away UUID (tokenRegistrationId) is sent and the real id is read from the response into tokenId. contractAddress must be a valid EVM address, and is normally filled in by the Deploy MiniUSDT step."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// registerTokenSchema needs a uuid 'tokenId' in the body (ignored by the server).",
                  "pm.collectionVariables.set('tokenRegistrationId', pm.variables.replaceIn('{{$guid}}'));",
                  "",
                  "const addr = (pm.collectionVariables.get('tokenContractAddress') || '').trim();",
                  "pm.collectionVariables.set('tokenContractAddress', addr);",
                  "if (!/^0x[0-9a-fA-F]{40}$/.test(addr)) {",
                  "    console.error(`tokenContractAddress is not a valid EVM address: '${addr}'. Run 'Deploy MiniUSDT (Anvil RPC)' first.`);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    pm.collectionVariables.set('tokenId', pm.response.json().data.id);",
                  "}",
                  "else {",
                  "    console.log('Token creation failed:', pm.response.text());",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "MANUAL STEP - Make wallets CUSTODIAL (run commands, then continue)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/health",
            "description": "Wallets created through the API are EXTERNAL, so the API cannot sign for them. Make them CUSTODIAL with an encrypted custody key before running Transfer. The commands are printed in the Postman Console. Needs attach-custody-key.mjs in your current directory; the default private keys are Anvil accounts #1 (sender) and #2 (receiver) and must match walletAddress / receiverAddress."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const g = (k) => pm.collectionVariables.get(k);",
                  "const api = g('apiContainer');",
                  "",
                  "if (!g('walletId') || !g('receiverWalletId')) {",
                  "    console.warn('walletId or receiverWalletId is empty. Run Create Sender/Receiver Wallet first.');",
                  "}",
                  "",
                  "console.log('>>> Make the wallets CUSTODIAL with a custody key (run both, from the folder containing attach-custody-key.mjs):');",
                  "console.log(`docker exec -i -e WALLET_ID=${g('walletId')} -e PRIVATE_KEY_HEX=${g('senderPrivateKey')} ${api} node --input-type=module - < scripts/attach-custody-key.mjs`);",
                  "console.log(`docker exec -i -e WALLET_ID=${g('receiverWalletId')} -e PRIVATE_KEY_HEX=${g('receiverPrivateKey')} ${api} node --input-type=module - < scripts/attach-custody-key.mjs`);",
                  "",
                  "console.log('>>> Type-only fallback (NO key attached, signing will still fail):');",
                  "console.log(`docker exec -it blockchain-postgres psql -U tether -d mini_tether -c \"UPDATE \\\\\"Wallet\\\\\" SET \\\\\"custodyType\\\\\" = 'CUSTODIAL' WHERE id IN ('${g('walletId')}', '${g('receiverWalletId')}');\"`);"
                ]
              }
            }
          ]
        }
      ],
      "description": "Requires an ADMIN access token. Promote the user in the DB (see the MANUAL STEP in folder 01), then re-run Login."
    },
    {
      "name": "04 - Mint & Transfer",
      "item": [
        {
          "name": "Mint To Sender",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-tenant-key",
                "value": "{{tenantApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"receiver\": \"{{walletAddress}}\", \"amount\": \"{{mintAmount}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/tokens/{{tokenId}}/mint",
            "description": "ADMIN only. amount is a string in base units (6 decimals: 1000000000 = 1000 mUSDT). receiver is assumed to be an address."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Mint returns 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    console.log('Mint tx:', pm.response.json().data.transactionHash);",
                  "}",
                  "else {",
                  "    console.log('Mint failed:', pm.response.text());",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer Sender -> Receiver (ASSUMED ENDPOINT - see notes)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-tenant-key",
                "value": "{{tenantApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"fromWalletId\": \"{{walletId}}\", \"toWalletId\": \"{{receiverWalletId}}\", \"tokenId\": \"{{tokenId}}\", \"amount\": \"{{transferAmount}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/transactions",
            "description": "Route and body shape are guesses. Adjust to your real transfer route. The sender wallet must be CUSTODIAL with a custody key attached, otherwise the API cannot sign."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Transfer accepted', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]));",
                  "if (![200, 201, 202].includes(pm.response.code)) {",
                  "    console.log('Transfer failed:', pm.response.text());",
                  "}"
                ]
              }
            }
          ]
        }
      ],
      "description": "Mint needs ADMIN. Transfer needs the sender wallet to be CUSTODIAL with a custody key (EXTERNAL wallets created via the API cannot be signed for)."
    },
    {
      "name": "05 - Reconciliation",
      "item": [
        {
          "name": "Get Latest Block (Anvil RPC)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"eth_blockNumber\", \"params\": []}"
            },
            "url": "{{rpcUrl}}",
            "description": "Calls Anvil directly (host port, not the docker-internal anvil:8545) and saves the current block into blockNumber."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const result = pm.response.json().result;",
                  "pm.collectionVariables.set('blockNumber', String(parseInt(result, 16)));",
                  "console.log('Latest block:', parseInt(result, 16));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reconcile Latest",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-tenant-key",
                "value": "{{tenantApiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/tokens/{{tokenId}}/balance/{{walletId}}/reconcile"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Give the worker time to index the Transfer events before reconciling.",
                  "const wait = parseInt(pm.collectionVariables.get('indexerWaitMs') || '0', 10);",
                  "if (wait > 0) { setTimeout(() => {}, wait); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Reconcile returns 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const d = pm.response.json().data;",
                  "    console.log('Reconcile status:', d.status);",
                  "    console.log('Persisted:', JSON.stringify(d.persisted));",
                  "    console.log('Chain:', JSON.stringify(d.chain));",
                  "}",
                  "else {",
                  "    console.log('Reconcile failed:', pm.response.text());",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Reconcile Pinned Block",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-tenant-key",
                "value": "{{tenantApiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/tokens/{{tokenId}}/balance/{{walletId}}/reconcile?blockNumber={{blockNumber}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Give the worker time to index the Transfer events before reconciling.",
                  "const wait = parseInt(pm.collectionVariables.get('indexerWaitMs') || '0', 10);",
                  "if (wait > 0) { setTimeout(() => {}, wait); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Reconcile returns 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const d = pm.response.json().data;",
                  "    console.log('Reconcile status:', d.status);",
                  "    console.log('Persisted:', JSON.stringify(d.persisted));",
                  "    console.log('Chain:', JSON.stringify(d.chain));",
                  "}",
                  "else {",
                  "    console.log('Reconcile failed:', pm.response.text());",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}