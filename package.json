{
  "name": "blockchain-transaction-simulator",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "api:dev": "tsx watch src/api/server.ts",
    "build": "tsc",
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.ts --network localhost",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "test": "cross-env NODE_ENV=test vitest --pool=forks --poolOptions.forks.singleFork",
    "test:watch": "cross-env NODE_ENV=test vitest --watch",
    "test:coverage": "cross-env NODE_ENV=test vitest --coverage",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "worker:event-listener": "tsx src/workers/event-listener.runner.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wahid-nwr/blockchain-transaction-simulator.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/wahid-nwr/blockchain-transaction-simulator/issues"
  },
  "homepage": "https://github.com/wahid-nwr/blockchain-transaction-simulator#readme",
  "dependencies": {
    "@fastify/jwt": "^10.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "viem": "^2.55.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nomicfoundation/hardhat-ethers": "^4.0.14",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "hardhat": "^3.9.1",
    "prettier": "^3.9.5",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.7"
  }
}
