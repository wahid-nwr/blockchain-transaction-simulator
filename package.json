{
  "name": "blockchain-transaction-simulator",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "api:dev": "tsx watch src/api/server.ts",
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy-mini-usdt.ts --network localhost",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "test": "cross-env NODE_ENV=test vitest --pool=forks --poolOptions.forks.singleFork",
    "test:watch": "cross-env NODE_ENV=test vitest --watch",
    "test:coverage": "cross-env NODE_ENV=test vitest --coverage",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "worker:event-listener": "tsx src/workers/event-listener.runner.ts",
    "worker:confirmation": "tsx src/workers/confirmation.queue.runner.ts",
    "load-test": "k6 run load-test/transfer-flow.js",
    "load-test:smoke": "k6 run --vus 1 --duration 30s load-test/transfer-flow.js",
    "load-test:soak": "k6 run --vus 50 --duration 5m load-test/transfer-flow.js",
    "load-test:seed": "tsx load-test/seed.ts",
    "e2e:setup": "tsx test/e2e/setup.ts",
    "test:e2e": "bash scripts/test-e2e.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wahid-nwr/blockchain-transaction-simulator.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/wahid-nwr/blockchain-transaction-simulator/issues"
  },
  "homepage": "https://github.com/wahid-nwr/blockchain-transaction-simulator#readme",
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1106.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.9",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "uuid": "^14.0.1",
    "viem": "^2.55.1",
    "zod": "^4.4.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.205.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/instrumentation-http": "^0.205.0",
    "@opentelemetry/instrumentation-undici": "^0.15.0",
    "@opentelemetry/instrumentation-fastify": "^0.51.0",
    "@opentelemetry/instrumentation-ioredis": "^0.51.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nomicfoundation/hardhat-ethers": "^4.0.14",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^26.1.1",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "hardhat": "^3.9.1",
    "prettier": "^3.9.5",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}